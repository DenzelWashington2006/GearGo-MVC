@model List<GearGo.Models.Equipment>
@{
    ViewData["Title"] = "Equipment";
}

<h1>Equipment</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Daily Rate</th>
            <th>Available</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Category</td>
            <td>R @item.DailyRate.ToString("N2")</td>
            <td>@(item.IsAvailable ? "Yes" : "No")</td>
            <td><a asp-action="Details" asp-route-id="@item.Id">Details</a></td>
        </tr>
    }
    </tbody>
</table>